{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff --staged)",
      "Bash(git log --oneline)",
      "mcp__catalogue__lire_fiche"
    ],
    "ask": [
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(py*unittest*)",
      "Bash(just *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./exemples/mcp-serveur/**)",
      "Edit(./.mcp.json)",
      "Edit(./exemples/mod/bilan-outils/**)",
      "Edit(./justfile)",
      "Edit(./.githooks/**)",
      "Edit(./.git/config)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": []
    },
    "filesystem": {
      "denyRead": ["./secrets"]
    }
  }
}
